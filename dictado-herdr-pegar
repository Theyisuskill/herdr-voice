#!/usr/bin/env python3
import json, os, subprocess
from pathlib import Path
runtime = Path(os.environ.get('XDG_RUNTIME_DIR', '/tmp'))
text_path = runtime / 'dictado-herdr-texto.txt'
pane_path = runtime / 'dictado-herdr-panel.json'
try:
    transcript = text_path.read_text().strip()
    original = json.loads(pane_path.read_text())
    current = json.loads(subprocess.check_output(['herdr-app', 'status'], text=True))
    if not transcript:
        raise ValueError('transcripción vacía')
    subprocess.run(['wl-copy', '--type', 'text/plain;charset=utf-8'], input=transcript, text=True, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if not original.get('focused_pane') or current.get('focused_pane') != original['focused_pane'] or current.get('tab') != original.get('tab'):
        subprocess.run(['notify-send', 'Dictado', 'El panel cambió; el texto está en el portapapeles.'])
    else:
        subprocess.run(['herdr-app', 'do', 'terminal.paste'], check=True, capture_output=True)
except Exception:
    subprocess.run(['notify-send', 'Dictado', 'No se pudo pegar automáticamente. Revisa el portapapeles.'])
finally:
    text_path.unlink(missing_ok=True)
    pane_path.unlink(missing_ok=True)
