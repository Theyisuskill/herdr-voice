#!/usr/bin/env python3
import fcntl
import os
import subprocess
import time
from pathlib import Path

path = Path(os.environ.get('XDG_RUNTIME_DIR', '/tmp')) / f'voxtype-toggle-{os.getuid()}.lock'
with path.open('a+') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    lock.seek(0)
    previous = lock.read().strip()
    now = time.monotonic()
    if previous and now - float(previous) < 1.2:
        raise SystemExit(0)
    lock.seek(0)
    lock.truncate()
    lock.write(str(now))
    lock.flush()
    status = subprocess.run(['voxtype', 'status'], capture_output=True, text=True)
    if status.stdout.strip() == 'idle':
        runtime = Path(os.environ.get('XDG_RUNTIME_DIR', '/tmp'))
        (runtime / 'dictado-herdr-texto.txt').unlink(missing_ok=True)
        result = subprocess.run(['herdr-app', 'status'], capture_output=True, text=True)
        (runtime / 'dictado-herdr-panel.json').write_text(result.stdout if result.returncode == 0 else '{}')
    subprocess.run(['voxtype', 'record', 'toggle'], check=False)
